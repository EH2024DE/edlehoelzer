# Hosting secrets only, never put populated values into the public site/repository.
SHOP_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SHOP_ADMIN_TOKEN=
SHOP_PUBLIC_ORIGIN=https://edlehoelzer.de
# An absolute private directory OUTSIDE the Git checkout, on durable storage.
SHOP_DATA_DIR=/var/lib/edle-shop
# Set only after price, shipping, policies and end-to-end sandbox review.
SHOP_TEST_APPROVED=no
SHOP_BIND_HOST=127.0.0.1
PORT=8170
